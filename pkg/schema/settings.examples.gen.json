{
  "examples": {
    "": {
      "summary": "SQL Server Authentication",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "secure": {
          "password": {
            "create": "\u003cREPLACE_WITH_SECRET\u003e"
          }
        },
        "spec": {
          "jsonData": {
            "authenticationType": "SQL Server Authentication",
            "connMaxLifetime": 14400,
            "connectionTimeout": 0,
            "database": "grafana",
            "encrypt": "false",
            "maxIdleConns": 100,
            "maxIdleConnsAuto": true,
            "maxOpenConns": 100
          },
          "title": "MSSQL",
          "url": "localhost:1433",
          "user": "grafana"
        }
      }
    },
    "appRegistration": {
      "summary": "App Registration",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "secure": {
          "azureClientSecret": {
            "create": "\u003cREPLACE_WITH_SECRET\u003e"
          }
        },
        "spec": {
          "jsonData": {
            "authenticationType": "Azure AD Authentication",
            "azureCredentials": {
              "authType": "clientsecret",
              "azureCloud": "AzureCloud",
              "clientId": "00000000-0000-0000-0000-000000000002",
              "tenantId": "00000000-0000-0000-0000-000000000001"
            },
            "database": "grafana",
            "encrypt": "true"
          },
          "title": "MSSQL",
          "url": "example.database.windows.net:1433"
        }
      }
    },
    "currentUser": {
      "summary": "Current User",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "spec": {
          "jsonData": {
            "authenticationType": "Azure AD Authentication",
            "azureCredentials": {
              "authType": "currentuser"
            },
            "database": "grafana",
            "disableGrafanaCache": true,
            "encrypt": "true",
            "oauthPassThru": true
          },
          "title": "MSSQL",
          "url": "example.database.windows.net:1433"
        }
      }
    },
    "entraPassword": {
      "summary": "Azure Entra Password",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "secure": {
          "password": {
            "create": "\u003cREPLACE_WITH_SECRET\u003e"
          }
        },
        "spec": {
          "jsonData": {
            "authenticationType": "Azure AD Authentication",
            "azureCredentials": {
              "authType": "ad-password",
              "clientId": "00000000-0000-0000-0000-000000000002",
              "userId": "user@example.com"
            },
            "database": "grafana",
            "encrypt": "true"
          },
          "title": "MSSQL",
          "url": "example.database.windows.net:1433"
        }
      }
    },
    "kerberosCache": {
      "summary": "Windows AD: Credential cache",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "spec": {
          "jsonData": {
            "authenticationType": "Windows AD: Credential cache",
            "credentialCache": "/tmp/krb5cc_1000",
            "database": "grafana"
          },
          "title": "MSSQL",
          "url": "localhost:1433"
        }
      }
    },
    "kerberosCacheLookup": {
      "summary": "Windows AD: Credential cache file",
      "value": {
