    "managedIdentity": {
      "summary": "Managed Identity",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "spec": {
          "jsonData": {
            "authenticationType": "Azure AD Authentication",
            "azureCredentials": {
              "authType": "msi"
            },
            "database": "grafana",
            "encrypt": "true"
          },
          "title": "MSSQL",
          "url": "example.database.windows.net:1433"
        }
      }
    },
    "privateConnection": {
      "summary": "SQL Server Authentication via a Grafana Cloud private data source connection",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "secure": {
          "password": {
            "create": "\u003cREPLACE_WITH_SECRET\u003e"
          }
        },
        "spec": {
          "jsonData": {
            "authenticationType": "SQL Server Authentication",
            "database": "grafana",
            "enableSecureSocksProxy": true,
            "encrypt": "true",
            "secureSocksProxyUsername": "\u003cPRIVATE_NETWORK_ID\u003e"
          },
          "title": "MSSQL",
          "url": "sql.example.com:1433",
          "user": "grafana"
        }
      }
    },
    "skipTLSVerification": {
      "summary": "SQL Server Authentication with encryption and skipped certificate verification",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "secure": {
          "password": {
            "create": "\u003cREPLACE_WITH_SECRET\u003e"
          }
        },
        "spec": {
          "jsonData": {
            "authenticationType": "SQL Server Authentication",
            "database": "grafana",
            "encrypt": "true",
            "tlsSkipVerify": true
          },
          "title": "MSSQL",
          "url": "localhost:1433",
          "user": "grafana"
        }
      }
    },
    "strictEncryption": {
      "summary": "Self-managed Grafana with strict encryption and a local CA for SQL Server 2022 or later",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
        "kind": "DataSource",
        "metadata": {
          "name": "mssql"
        },
        "secure": {
          "password": {
            "create": "\u003cREPLACE_WITH_SECRET\u003e"
          }
        },
        "spec": {
          "jsonData": {
            "authenticationType": "SQL Server Authentication",
            "database": "grafana",
            "encrypt": "strict",
            "serverName": "sql.example.com",
            "sslRootCertFile": "/etc/grafana/certs/sql-ca.pem"
          },
          "title": "MSSQL",
          "url": "sql.example.com:1433",
          "user": "grafana"
        }
      }
    },
    "windows": {
      "summary": "Windows Authentication when Grafana runs on Windows under an account with SQL Server access",
      "value": {
        "apiVersion": "mssql.datasource.grafana.app/v0alpha1",
